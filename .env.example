# --- Supabase (database + image storage) ---
# Project Settings -> API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- SEO ---
# Public site URL used for canonical links, sitemap and OG tags
NEXT_PUBLIC_SITE_URL=https://yosuahares.vercel.app
# Google Search Console "HTML tag" verification code (content value only)
GOOGLE_SITE_VERIFICATION=
